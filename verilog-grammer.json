{
  "name": "Verilog",
  "fileTypes": [
    "verilog"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#string_block"
    },
    {
      "include": "#integer"
    },
    {
      "include": "#include"
    },
    {
      "include": "#user_constraint"
    },
    {
      "include": "#user_rewrite"
    },
    {
      "include": "#pattern"
    },
    {
      "include": "#inside_pattern"
    }
  ],
  "repository": {
    "comment": {
      "match": "\/\/.*$",
      "name": "comment.line.double-slash.verilog"
    },
    "string": {
      "name": "string.quoted.double.verilog",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.verilog"
        }
      },
      "patterns": [
        {
          "match": "\\\\[nt\"]",
          "name": "constant.character.escape.verilog"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.verilog"
        }
      ],
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.verilog"
        }
      }
    },
    "string_block": {
      "name": "string.quoted.triple.verilog",
      "begin": "\\[{",
      "end": "}]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.verilog"
        }
      },
      "patterns": [
        {
          "match": "\\\\[nt\"]",
          "name": "constant.character.escape.verilog"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.verilog"
        }
      ],
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.verilog"
        }
      }
    },
    "integer": {
      "match": "[0-9]+",
      "name": "constant.numeric.verilog"
    },
    "include": {
      "patterns": [
        {
          "match": "(#include)",
          "name": "keyword.control.verilog"
        }
      ]
    },
    "argument_or_result_list": {
      "patterns": [
        {
          "match": "\\b([aA-zZ_0-9]*)\\b\\s*:\\s*([aA-zZ_0-9]+)\\b(\\<([^\\>]+)\\>)?",
          "captures": {
            "1": {
              "name": "variable.parameter.verilog"
            },
            "2": {
              "name": "entity.name.type.verilog"
            },
            "4": {
              "name": "variable.other.enummember.verilog"
            }
          }
        },
        {
          "match": "(\\(|\\>|,)\\s*([aA-zZ_0-9]+)\\b(\\<([^\\>]+)\\>)?\\s*(?=[^:])",
          "captures": {
            "2": {
              "name": "entity.name.type.verilog"
            },
            "4": {
              "name": "variable.other.enummember.verilog"
            }
          }
        }
      ]
    },
    "user_constraint": {
      "patterns": [
        {
          "begin": "\\b(Constraint)\\b\\s*(\\b[aA-zZ_0-9]*\\b)?",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            },
            "2": {
              "name": "entity.name.type.verilog"
            }
          },
          "patterns": [
            {
              "begin": "(\\[{)",
              "patterns": [
                {
                  "include": "source.cpp"
                }
              ],
              "end": "(}])"
            },
            {
              "begin": "(?=\\()",
              "patterns": [
                {
                  "include": "#argument_or_result_list"
                }
              ],
              "end": "\\)"
            },
            {
              "include": "#argument_or_result_list"
            },
            {
              "begin": "{",
              "patterns": [
                {
                  "include": "#inside_pattern"
                }
              ],
              "end": "(?=})"
            },
            {
              "begin": "=>",
              "patterns": [
                {
                  "include": "#inside_pattern"
                }
              ],
              "end": "(?=;|,|\\))"
            }
          ],
          "end": "(}|;|,)|(?=\\))"
        }
      ]
    },
    "user_rewrite": {
      "patterns": [
        {
          "begin": "\\b(Rewrite)\\b\\s*(\\b[aA-zZ_0-9]*\\b)?",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            },
            "2": {
              "name": "entity.name.function.verilog"
            }
          },
          "patterns": [
            {
              "begin": "(\\[{)",
              "patterns": [
                {
                  "include": "source.cpp"
                }
              ],
              "end": "(}])"
            },
            {
              "begin": "(?=\\()",
              "patterns": [
                {
                  "include": "#argument_or_result_list"
                }
              ],
              "end": "\\)"
            },
            {
              "include": "#argument_or_result_list"
            },
            {
              "begin": "{",
              "patterns": [
                {
                  "include": "#inside_pattern"
                }
              ],
              "end": "(?=})"
            },
            {
              "begin": "=>",
              "patterns": [
                {
                  "include": "#inside_pattern"
                }
              ],
              "end": "(?=;|,|\\))"
            }
          ],
          "end": "(}|;|,)|(?=\\))"
        }
      ]
    },
    "pattern_metadata": {
      "patterns": [
        {
          "match": "\\b(with)\\b",
          "name": "keyword.other.verilog"
        },
        {
          "match": "\\b(benefit)\\b\\(([0-9]+)\\)",
          "captures": {
            "1": {
              "name": "entity.name.variable.verilog"
            },
            "2": {
              "name": "constant.numeric.verilog"
            }
          }
        },
        {
          "match": "\\b(recursion)\\b",
          "name": "entity.name.variable.verilog"
        }
      ]
    },
    "pattern": {
      "patterns": [
        {
          "begin": "\\b(Pattern)\\b\\s*(\\b[aA-zZ_0-9]*\\b)?\\s*(\\bwith\\b\\s*[^\\{]*)?\\s*({)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            },
            "2": {
              "name": "entity.name.function.verilog"
            },
            "3": {
              "patterns": [
                {
                  "include": "#pattern_metadata"
                }
              ]
            }
          },
          "patterns": [
            {
              "include": "#inside_pattern"
            }
          ],
          "end": "(})"
        },
        {
          "begin": "\\b(Pattern)\\b\\s*(\\b[aA-zZ_0-9]*\\b)?\\s*(\\bwith\\b\\s*[^\\=]*)?\\s*(=>)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            },
            "2": {
              "name": "entity.name.function.verilog"
            },
            "3": {
              "patterns": [
                {
                  "include": "#pattern_metadata"
                }
              ]
            }
          },
          "patterns": [
            {
              "include": "#inside_pattern"
            }
          ],
          "end": ";"
        }
      ]
    },
    "inside_pattern": {
      "patterns": [
        {
          "match": "\\b(erase|let|replace|return|rewrite|with)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.verilog"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "variable_constraint": {
      "patterns": [
        {
          "match": "\\b(Op)<([a-zA-Z0-9_\\.$-]*)>",
          "captures": {
            "1": {
              "name": "entity.name.type.verilog"
            },
            "2": {
              "name": "variable.other.enummember.verilog"
            }
          }
        },
        {
          "begin": "<",
          "patterns": [
            {
              "include": "#expressions"
            }
          ],
          "end": ">"
        },
        {
          "match": "[a-zA-Z_0-9]+",
          "name": "entity.name.type.verilog"
        }
      ]
    },
    "variable_definition": {
      "patterns": [
        {
          "begin": "\\b([aA-zZ_0-9]*)\\b\\s*:\\s*\\[",
          "beginCaptures": {
            "1": {
              "name": "entity.name.variable.verilog"
            }
          },
          "patterns": [
            {
              "include": "#variable_constraint"
            }
          ],
          "end": "\\]"
        },
        {
          "match": "\\b([aA-zZ_0-9]*)\\b\\s*:\\s*([aA-zZ_0-9]+(\\<([^\\>]+)\\>)?)",
          "captures": {
            "1": {
              "name": "entity.name.variable.verilog"
            },
            "2": {
              "patterns": [
                {
                  "include": "#variable_constraint"
                }
              ]
            }
          }
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#user_constraint"
        },
        {
          "include": "#user_rewrite"
        },
        {
          "include": "#attr_expr"
        },
        {
          "include": "#op_expr"
        },
        {
          "include": "#type_expr"
        },
        {
          "include": "#call_expr"
        },
        {
          "include": "#variable_definition"
        },
        {
          "include": "#identifier_expr"
        },
        {
          "include": "#string"
        },
        {
          "include": "#string_block"
        },
        {
          "include": "#comment"
        },
        {
          "begin": "{",
          "patterns": [
            {
              "include": "#inside_pattern"
            }
          ],
          "end": "}"
        },
        {
          "begin": "\\(",
          "patterns": [
            {
              "include": "#expressions"
            }
          ],
          "end": "\\)"
        }
      ]
    },
    "attr_expr": {
      "patterns": [
        {
          "begin": "(attr)<",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            }
          },
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#string_block"
            }
          ],
          "end": ">"
        }
      ]
    },
    "call_expr": {
      "begin": "\\b([a-zA-Z0-9_]+)\\(",
      "beginCaptures": {
        "1": {
          "name": "entity.name.variable.verilog"
        }
      },
      "patterns": [
        {
          "include": "#expressions"
        }
      ],
      "end": "\\)"
    },
    "identifier_expr": {
      "match": "\\b([a-zA-Z0-9_]+)\\b",
      "name": "entity.name.variable.verilog"
    },
    "op_expr": {
      "match": "\\b(op)<([0-9a-zA-Z_\\.]*)>",
      "captures": {
        "1": {
          "name": "keyword.other.verilog"
        },
        "2": {
          "name": "variable.other.enummember.verilog"
        }
      }
    },
    "type_expr": {
      "patterns": [
        {
          "begin": "\\b(type)<",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.verilog"
            }
          },
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#string_block"
            }
          ],
          "end": ">"
        }
      ]
    }
  },
  "scopeName": "source.verilog"
}